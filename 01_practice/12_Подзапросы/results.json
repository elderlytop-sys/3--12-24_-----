    "task": "Продвинутый случай: два CTE",
    "sql": "WITH averages AS (SELECT category_id,AVG(price) AS avg_price FROM product GROUP BY category_id), maxima AS (SELECT category_id,MAX(price) AS max_price FROM product GROUP BY category_id) SELECT c.id,c.name,a.avg_price,m.max_price FROM category c JOIN averages a ON a.category_id=c.id JOIN maxima m ON m.category_id=c.id ORDER BY c.id",
